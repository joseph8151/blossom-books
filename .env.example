# ─────────────────────────────────────────────────────────────
# Blossom Books — environment variables
# 실제 값은 .env.local 에 넣으세요 (.env.local 은 git에 커밋되지 않습니다).
# ─────────────────────────────────────────────────────────────

# PayPal 해외(International) 결제
# 클라이언트(브라우저)에 노출되는 공개 키입니다. 이 값이 없으면 체크아웃의
# 해외 결제 영역에 실제 PayPal 버튼 대신 "결제 준비 중" 안내 문구가 표시됩니다.
# Sandbox(테스트)와 Live(운영) 환경의 클라이언트 ID를 분리해서 사용하세요.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# 아래는 백엔드 구축 시 서버 전용(비공개) 값입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 결제 승인 후 서버에서 주문 금액·상품·상태를 재검증할 때 사용합니다.
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox   # sandbox | live

# ─────────────────────────────────────────────────────────────
# 상담·주문 문의 이메일 접수 (무료 폼서비스 Web3Forms)
# 1) https://web3forms.com 에서 "받을 이메일 주소"(예: yorkboy@gmail.com)로 무료 가입 → Access Key 발급
# 2) 아래에 그 키를 넣으세요. (Vercel 사용 시 Project Settings → Environment Variables 에 등록)
#    이 키만 있으면 접수 내용이 등록한 이메일로 자동 전송됩니다.
#    받을 이메일 주소는 Web3Forms에만 저장되며, 웹사이트 코드/화면에는 노출되지 않습니다.
#    키가 없으면 폼 제출 시 방문자의 메일 앱(mailto)으로 자동 대체됩니다.
# WEB3FORMS_ACCESS_KEY=
